# Copy to .env for local development. Every value here is fake or local-only.
DATABASE_URL=postgresql+psycopg://atlas:atlas-dev-password@localhost:5432/atlas
# At least 32 characters; Atlas refuses to start with a shorter one (lesson 4.8).
# Make your own: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-random-value
# Optional: a read-only GitHub token raises the API rate limit (lesson 2.5).
# GITHUB_TOKEN=
# Optional: GitHub sign-in (lesson 4.8). An empty value counts as set, so keep these
# commented out unless you have a GitHub OAuth app.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional: serve the ready-made web interface at /app.
WEB_DIR=../web
# The job queue (lesson 5.1); this is the default.
# REDIS_URL=redis://localhost:6379/0
# Where the worker keeps its clones (default: .cache/atlas/repos in your home folder).
# Use a full path: "~" is not expanded here.
# REPOS_DIR=/path/to/clones
# Shared with GitHub when you create a webhook (lesson 5.2). Unset disables /webhooks/github.
# GITHUB_WEBHOOK_SECRET=
# Object storage for snapshots (lesson 5.4): SeaweedFS from compose.yml. Leave the endpoint
# unset on AWS, where boto3 talks to S3 and gets credentials from the task's IAM role.
S3_ENDPOINT_URL=http://localhost:8333
# boto3 reads its credentials from the process environment, not from this file, so export
# the throwaway local ones from compose.yml in the shell that runs the worker or API:
#   export AWS_ACCESS_KEY_ID=atlas AWS_SECRET_ACCESS_KEY=atlas-dev-secret-key
